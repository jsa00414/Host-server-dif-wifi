[Unit]
Description=Tailscale exit DNS filter (AdGuard -> Pi-hole)
After=network-online.target sm-adguard.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'IF=$(grep ^IFACE= /opt/dns/ts-vpn-exit.state 2>/dev/null | cut -d= -f2); /opt/dns/ts-exit-dns.sh enable "${IF:-tailscale0}"'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
