[Unit]
Description=sslh multiplex HTTPS+OpenVPN on :443
After=network-online.target docker.service openvpn-server-sm.service
Wants=network-online.target

[Service]
Type=forking
PIDFile=/run/sslh/sslh.pid
ExecStartPre=/bin/mkdir -p /run/sslh
ExecStartPre=/bin/chown sslh:sslh /run/sslh
ExecStart=/usr/sbin/sslh --user=sslh --listen=0.0.0.0:443 --tls=127.0.0.1:4443 --openvpn=127.0.0.1:8443 --anyprot=127.0.0.1:4443 --pidfile=/run/sslh/sslh.pid
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
