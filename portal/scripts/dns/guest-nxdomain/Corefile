# Guest / out-of-circle DNS: NXDOMAIN for admin hostnames so browsers show a
# real "This site can't be reached" / DNS_PROBE_FINISHED_NXDOMAIN page.
# Everything else forwards to public resolvers.
# keys.* stays resolvable so Authenticator enroll still works off-circle.

portal.vpstruelord.com:53 {
    template IN ANY {
        rcode NXDOMAIN
    }
}

router.vpstruelord.com:53 {
    template IN ANY {
        rcode NXDOMAIN
    }
}

