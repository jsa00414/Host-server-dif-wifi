[Unit]
Description=ServerManager NAS SMB gateway (Windows Explorer public route)
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/bin/bash -c 'mountpoint -q /mnt/nas-gateway || mount /mnt/nas-gateway || true'
ExecStart=/usr/sbin/smbd -F --no-process-group -s /opt/wireguard/nas-smb-gateway/smb.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
