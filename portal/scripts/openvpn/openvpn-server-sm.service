[Unit]
Description=ServerManager OpenVPN (TCP 8443)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStartPre=/opt/openvpn/scripts/ovpn-firewall.sh
ExecStart=/usr/sbin/openvpn --config /opt/openvpn/server.conf
WorkingDirectory=/opt/openvpn
Restart=on-failure
RestartSec=3
LimitNOFILE=65536
KillMode=process

[Install]
WantedBy=multi-user.target
