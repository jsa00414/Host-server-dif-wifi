[Unit]
Description=Surfshark exit DNS filter (AdGuard -> Pi-hole)
After=network-online.target sm-adguard.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash -c 'IF=$(grep ^IFACE= /opt/surfshark/ss-vpn-exit.state 2>/dev/null | cut -d= -f2); /opt/surfshark/ss-exit-dns.sh enable "$IF"'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
