#!/usr/bin/env bash
# Hand eMeet HD Webcam between Proxmox / Windows VMs.
#
# Device: eMeet HD Webcam C960  328f:006d
# Default RDP target VM: 102 (win11-rdp)
# Legacy gaming VM that often held it: 100 (path host=3-3.1.3)
#
# Usage:
#   webcam-usb-owner status
#   webcam-usb-owner to-rdp      # pass to VM 102
#   webcam-usb-owner to-gaming   # pass back to VM 100
#   webcam-usb-owner to-host     # detach from all VMs
set -euo pipefail

VENDOR_PRODUCT="${WEBCAM_USB_ID:-328f:006d}"
RDP_VMID="${WEBCAM_RDP_VMID:-102}"
GAMING_VMID="${WEBCAM_GAMING_VMID:-100}"
RDP_USB_SLOT="${WEBCAM_RDP_USB_SLOT:-usb1}"
GAMING_USB_SLOT="${WEBCAM_GAMING_USB_SLOT:-usb3}"
# Historical bus path used on VM 100
LEGACY_PATH="${WEBCAM_USB_PATH:-3-3.1.3}"
OWNER_PATH="/etc/proxmox-webcam/owner"

mkdir -p "$(dirname "$OWNER_PATH")"

host_has_device() {
  lsusb -d "$VENDOR_PRODUCT" >/dev/null 2>&1
}

vm_has_usb() {
  local vmid="$1"
  local cfg
  cfg="$(qm config "$vmid" 2>/dev/null || true)"
  [[ -n "$cfg" ]] || return 1
  echo "$cfg" | grep -qiE "^usb[0-9]+:.*(${VENDOR_PRODUCT}|host=${LEGACY_PATH}\\b|328f:006d)"
}

detach_from_vm() {
  local vmid="$1"
  local line key val
  mapfile -t lines < <(qm config "$vmid" 2>/dev/null | grep -E '^usb[0-9]+:' || true)
  for line in "${lines[@]}"; do
    key="${line%%:*}"
    val="${line#*: }"
    if [[ "$val" == *"$VENDOR_PRODUCT"* ]] || [[ "$val" == *"$LEGACY_PATH"* ]] || [[ "$val" == *"328f:006d"* ]]; then
      echo "detach $key ($val) from VM ${vmid}"
      qm set "$vmid" --delete "$key" >/dev/null 2>&1 || true
    fi
  done
}

write_owner() {
  printf '%s\n' "$1" >"$OWNER_PATH"
}

read_owner() {
  if [[ -f "$OWNER_PATH" ]]; then
    tr -d '[:space:]' <"$OWNER_PATH"
    return
  fi
  if vm_has_usb "$RDP_VMID"; then
    echo rdp
  elif vm_has_usb "$GAMING_VMID"; then
    echo gaming
  elif host_has_device; then
    echo host
  else
    echo unknown
  fi
}

cmd_status() {
  local owner rdp=0 gaming=0 host=0
  owner="$(read_owner)"
  vm_has_usb "$RDP_VMID" && rdp=1
  vm_has_usb "$GAMING_VMID" && gaming=1
  host_has_device && host=1
  local ok=0
  case "$owner" in
    rdp) [[ "$rdp" -eq 1 ]] && ok=1 ;;
    gaming) [[ "$gaming" -eq 1 ]] && ok=1 ;;
    host) [[ "$host" -eq 1 && "$rdp" -eq 0 && "$gaming" -eq 0 ]] && ok=1 ;;
  esac
  echo "ok=${ok} owner=${owner} id=${VENDOR_PRODUCT} rdp_usb=${rdp} gaming_usb=${gaming} host_usb=${host} rdp_vmid=${RDP_VMID} gaming_vmid=${GAMING_VMID} rdp_slot=${RDP_USB_SLOT}"
}

attach_to_vm() {
  local vmid="$1" slot="$2" owner_name="$3"
  if ! qm status "$vmid" >/dev/null 2>&1; then
    echo "VM ${vmid} not found" >&2
    exit 1
  fi
  if ! qm status "$vmid" | grep -q running; then
    echo "VM ${vmid} is not running — start it first" >&2
    exit 1
  fi

  detach_from_vm "$RDP_VMID"
  detach_from_vm "$GAMING_VMID"
  # Also clear preferred slots in case of stale config
  qm set "$RDP_VMID" --delete "$RDP_USB_SLOT" >/dev/null 2>&1 || true
  qm set "$GAMING_VMID" --delete "$GAMING_USB_SLOT" >/dev/null 2>&1 || true
  sleep 1

  local i
  for i in $(seq 1 30); do
    host_has_device && break
    sleep 0.5
  done
  if ! host_has_device; then
    echo "Webcam ${VENDOR_PRODUCT} not found on host after detach" >&2
    cmd_status
    exit 1
  fi

  qm set "$vmid" -"$slot" "host=${VENDOR_PRODUCT},usb3=1"
  sleep 1
  if ! vm_has_usb "$vmid"; then
    echo "failed to attach webcam to VM ${vmid}" >&2
    cmd_status
    exit 1
  fi
  write_owner "$owner_name"
  cmd_status
  echo "Webcam ${VENDOR_PRODUCT} handed to VM ${vmid} on ${slot} (owner=${owner_name})."
}

cmd_to_rdp() {
  attach_to_vm "$RDP_VMID" "$RDP_USB_SLOT" rdp
}

cmd_to_gaming() {
  attach_to_vm "$GAMING_VMID" "$GAMING_USB_SLOT" gaming
}

cmd_to_host() {
  detach_from_vm "$RDP_VMID"
  detach_from_vm "$GAMING_VMID"
  qm set "$RDP_VMID" --delete "$RDP_USB_SLOT" >/dev/null 2>&1 || true
  qm set "$GAMING_VMID" --delete "$GAMING_USB_SLOT" >/dev/null 2>&1 || true
  sleep 1
  local i
  for i in $(seq 1 30); do
    host_has_device && break
    sleep 0.5
  done
  write_owner host
  cmd_status
  echo "Webcam detached; available on Proxmox host."
}

usage() {
  echo "Usage: webcam-usb-owner status|to-rdp|to-gaming|to-host"
  echo "  device=${VENDOR_PRODUCT}  rdp_vmid=${RDP_VMID}  gaming_vmid=${GAMING_VMID}"
}

main() {
  local action="${1:-}"
  case "$action" in
    status) cmd_status ;;
    to-rdp|rdp) cmd_to_rdp ;;
    to-gaming|gaming|to-windows) cmd_to_gaming ;;
    to-host|host) cmd_to_host ;;
    -h|--help|"") usage; exit 2 ;;
    *) echo "unknown: $action" >&2; usage; exit 2 ;;
  esac
}

main "$@"
